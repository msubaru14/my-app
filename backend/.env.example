# DB
# Production example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local Docker development fallback:
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydb

#環境変数
JWT_SECRET=mysecret
FRONTEND_URL=http://localhost:5173
GIN_MODE=debug
